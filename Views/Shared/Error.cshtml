@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container my-5 text-center">
    <h1 class="text-danger">Ocurrió un error</h1>
    <p class="lead">No pudimos procesar tu solicitud. Intenta de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">
            <strong>Código de la solicitud:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Volver al inicio</a>
</div>
