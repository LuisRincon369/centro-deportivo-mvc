@model List<Plan>
@{
    ViewData["Title"] = "Inicio";
}

<!-- ============================================================
     HERO - presentación del centro deportivo
     ============================================================ -->
<section class="hero d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold text-white">Entrena con propósito</h1>
                <p class="lead text-white-50">
                    Planes de entrenamiento funcional, clases grupales y acompañamiento profesional
                    para alcanzar tus metas físicas.
                </p>
                <a asp-controller="Inscripciones" asp-action="Crear" class="btn btn-warning btn-lg fw-bold me-2 mb-2">Inscríbete ahora</a>
                <a asp-controller="Clases" asp-action="Index" class="btn btn-outline-light btn-lg mb-2">Ver horario</a>
            </div>
            <div class="col-lg-6">
                <img src="~/img/pexels-wolfart-36389486.jpg" alt="Atleta entrenando en el gimnasio"
                     class="img-fluid rounded shadow hero-img">
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     PLANES - las tarjetas se generan recorriendo la lista (Model)
     que envió el HomeController
     ============================================================ -->
<section class="container my-5">
    <h2 class="text-center mb-2">Nuestros Planes</h2>
    <p class="text-center text-muted mb-4">Elige la membresía que mejor se adapte a tus objetivos</p>

    <div class="row g-4">
        @foreach (var plan in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 plan-card @(plan.Destacado ? "shadow border-warning" : "shadow-sm")">
                    <div class="card-body text-center">
                        @if (plan.Destacado)
                        {
                            <span class="badge bg-warning text-dark mb-2">Más popular</span>
                        }
                        <h3 class="card-title">@plan.Nombre</h3>
                        <p class="display-6">@plan.Precio.ToString("C0")<small class="fs-6 text-muted">/mes</small></p>
                        <ul class="list-unstyled text-start">
                            @foreach (var beneficio in plan.Beneficios)
                            {
                                <li>✔ @beneficio</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>

    <p class="text-center text-muted small mt-4">
        Menores de 18 y mayores de 60 años reciben 15% de descuento en cualquier plan.
    </p>
</section>
